#!/usr/bin/env python
# lestoroer#local-lights
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_local_lights = env_modules.Clone()

if "RD_GLSL" in env["BUILDERS"]:
    for shader in ["shaders/local_light_caster.glsl", "shaders/local_light_ratio.glsl", "shaders/local_light_blur.glsl"]:
        env_local_lights.RD_GLSL(shader)

env_local_lights.add_source_files(env.modules_sources, "*.cpp")
